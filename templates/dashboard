<!DOCTYPE html>
<html>

<head>

    <title>Analytics Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

</head>

<body class="bg-light">

<nav class="navbar navbar-dark bg-dark">

    <div class="container-fluid">

        <a class="navbar-brand" href="/">
            AI Resume Analyzer
        </a>

        <div>

            <a class="btn btn-light me-2" href="/">
                Home
            </a>

            <a class="btn btn-warning me-2" href="/history">
                History
            </a>

            <a class="btn btn-success" href="/dashboard">
                Dashboard
            </a>

        </div>

    </div>

</nav>

<div class="container mt-4">

    <h1 class="text-center mb-4">
        Analytics Dashboard
    </h1>

    <div class="row">

        <div class="col-md-4">

            <div class="card shadow p-3">

                <h5>Total Resumes</h5>

                <h2>{{ total_resumes }}</h2>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow p-3">

                <h5>Average ATS Score</h5>

                <h2>{{ avg_ats }}%</h2>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow p-3">

                <h5>Average Match Score</h5>

                <h2>{{ avg_match }}%</h2>

            </div>

        </div>

    </div>

    <br>

    <div class="card shadow p-4">

        <h3>Role Distribution</h3>

        <canvas id="roleChart"></canvas>

        <br><br>
        
        <h3>Role Distribution Pie Chart</h3>
        
        <canvas id="pieChart"></canvas>

    </div>

</div>

<script>

const ctx = document.getElementById('roleChart').getContext('2d');

new Chart(ctx, {

    type: 'bar',

    data: {

        labels: {{ labels | tojson }},

        datasets: [{

            label: 'Number of Analyses',

            data: {{ values | tojson }},

            borderWidth: 1

        }]

    },

    options: {

        responsive: true,

        scales: {

            y: {

                beginAtZero: true

            }

        }

    }

});

</script>

<script>

const pieCtx = document.getElementById('pieChart').getContext('2d');

new Chart(pieCtx, {

    type: 'pie',

    data: {

        labels: {{ labels | tojson }},

        datasets: [{

            data: {{ values | tojson }}

        }]

    }

});

</script>

</body>
</html>
